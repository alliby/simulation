   local function get_proc_address(lib: HMODULE, fn_name: cstring <comptime>): auto <inline>
     local f = #|fn_name.value|#
     local f_type = #[f.possibletypes[1]]#
     local address = (@f_type)(GetProcAddress(lib, fn_name))
     if not address then
	print("Could not found symbol: ", fn_name)
     end
     return address
   end
   
