require "common"
require "ode"
require "ui"
require "scene"
require "math"

--   m*x'' = -k*x - b*x'

-- Physics parameters
local mass: float64 = 2.0    -- kg
local k: float64 = 50.0      -- N/m
local b: float64 = 0.5       -- N*s/m
local rest_length: float64 = 1.0 -- m

-- Initial conditions
local x0: float64 = 0.5 -- m, displacement from rest length
local v0: float64 = 0.0 -- m/s

-- Runtime state
local x: float64 = x0
local v: float64 = 0.0
local integrator = Integrator.RK4

local function accel(t: float64, pos: float64, vel: float64): float64
   return -(k/mass) * pos - (b/mass) * vel
end

local function reset()
   x = x0
   v = v0
end

local function step(t: float64, h: float64)
   x, v = integrate_2_step(integrator, accel, t, h, x, v)
end

local function draw(vg: *NVGcontext, w: float64, h: float64)
   local rest_px = (@float32)(rest_length * PX_PER_M)
   local len_px = rest_px + (@float32)(x * PX_PER_M)
   local anchor_x = (@float32)(w / 4 - 7.5)
   local mid_y = (@float32)(h / 2)

   local damper = Damper { position = { anchor_x, mid_y - 10.0 }, length = len_px }
   local spring = Spring { position = { anchor_x, mid_y + 30.0 }, length = len_px }

   local h_ground = Ground.new { position = { anchor_x - 62.5, mid_y }, size = { 100.0, 30.0 }, rotation = -math.pi / 2 }
   local v_ground = Ground.new { position = { anchor_x + 7.5, mid_y + 70.0 }, size = { 500.0, 30.0 }, rotation = math.pi }

   drawGround(vg, h_ground)
   drawGround(vg, v_ground)
   drawSpring(vg, spring)
   drawDamper(vg, damper)

   local block = (@Rect){ anchor_x + len_px, mid_y - 27.5, 100.0, 75.0 }
   drawRect(vg, block)
end

local function panel(ui: *UI)
   ui:label("Physics")
   ui:slider("Mass (kg)", &mass, 0.2, 10.0)
   ui:slider("Stiffness k", &k, 1.0, 200.0)
   ui:slider("Damping b", &b, 0.0, 10.0)
   ui:slider("Rest length (m)", &rest_length, 0.3, 2.0)
   ui:separator()
   ui:label("Integrator")
   integrator = (@Integrator)(ui:options(integrator_names, integrator))
   ui:separator()
   ui:label("Initial conditions")
   local ic_changed = false
   if ui:slider("Displacement (m)", &x0, -1.5, 1.5) then ic_changed = true end
   if ui:slider("Velocity (m/s)", &v0, -10.0, 10.0) then ic_changed = true end
   if ic_changed then
      reset()
      pause_requested = true
   end
end

register_scene({
   name = "Spring-mass-damper",
   reset = reset,
   step = step,
   draw = draw,
   panel = panel,
})
