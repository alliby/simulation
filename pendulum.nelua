require "common"
require "ode"
require "ui"
require "scene"
require "math"

-- I * theta'' = -b * theta' - m*g*L*sin(theta)   (I = m*L^2)
-- =>  theta'' = -(b/I) * theta' - (g/L) * sin(theta)

-- Physics parameters
local mass: float64 = 1.0     -- kg
local length: float64 = 1.2   -- m
local damping: float64 = 0.15 -- N*m*s / rad
local gravity: float64 = 9.81 -- m/s^2

-- Initial conditions
local theta0: float64 = math.pi / 4
local omega0: float64 = 0.0

-- Runtime state
local theta: float64 = theta0
local omega: float64 = 0.0
local integrator = Integrator.RK4

local function accel(t: float64, th: float64, dth: float64): float64
   local I = mass * length * length
   return -(damping / I) * dth - (gravity / length) * math.sin(th)
end

local function reset()
   theta = theta0
   omega = omega0
end

local function step(t: float64, h: float64)
   theta, omega = integrate_2_step(integrator, accel, t, h, theta, omega)
end

local function draw(vg: *NVGcontext, w: float64, h: float64)
   local pivot = (@Vec2){ (@float32)(w * 0.5), (@float32)(h * 0.28) }
   local radius = clampf(0.06 * math.cbrt(mass), 0.03, 0.25) * PX_PER_M
   local rod_len = length * PX_PER_M

   local pend = Pendulum.new {
      position = pivot,
      length = (@float32)(rod_len),
      rotation = (@float32)((math.pi / 2) - theta),
      ball_radius = (@float32)(radius),
   }
   drawPendulum(vg, pend)

   -- pivot mount
   nvgBeginPath(vg)
   nvgCircle(vg, pivot.x, pivot.y, 5.0)
   nvgFillColor(vg, nvgRGB(15, 15, 15))
   nvgFill(vg)
end

local function panel(ui: *UI)
   ui:label("Physics")
   ui:slider("Mass (kg)", &mass, 0.1, 5.0)
   ui:slider("Length (m)", &length, 0.3, 2.5)
   ui:slider("Damping", &damping, 0.0, 1.0)
   ui:slider("Gravity", &gravity, 1.0, 20.0)
   ui:separator()
   ui:label("Integrator")
   integrator = (@Integrator)(ui:options(integrator_names, integrator))
   ui:separator()
   ui:label("Initial conditions")
   local ic_changed = false
   if ui:slider("Angle (rad)", &theta0, -math.pi, math.pi) then ic_changed = true end
   if ui:slider("Ang. vel.", &omega0, -10.0, 10.0) then ic_changed = true end
   if ic_changed then
      reset()
      pause_requested = true
   end
end

register_scene({
   name = "Pendulum",
   reset = reset,
   step = step,
   draw = draw,
   panel = panel,
})
